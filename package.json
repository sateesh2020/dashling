{
  "name": "dashling",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted desk-panel dashboard for your phone: computer stats, controls, OBS, weather, news and more.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "test:gates": "bash test/gates/refusals.sh && bash test/gates/linux.sh",
    "lint": "node scripts/check-syntax.mjs && bash scripts/lint-shell.sh",
    "check": "npm run lint && npm test",
    "demo": "node scripts/demo/server.mjs",
    "site": "node scripts/build-site.mjs"
  },
  "devDependencies": {
    "ws": "^8.18.0"
  }
}
